# ---- 依赖 ----
node_modules
.pnp
.pnp.js

# ---- 构建产物 ----
dist
dist-ssr
build
*.local
# TypeScript 增量编译缓存
*.tsbuildinfo

# ---- 日志 ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 测试 / 覆盖率 ----
coverage
.vitest
.nyc_output

# ---- 环境变量 / 密钥 ----
