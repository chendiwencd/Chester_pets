.env
.env.*
!.env.example
*.pem

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# 注意：Rust / Tauri 的忽略（/target、/gen/schemas）在 src-tauri/.gitignore 里单独维护。
