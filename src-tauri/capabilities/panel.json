{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Capability for the 3 floating content panels (image/text/web)",
  "windows": ["panel-*", "preview", "image-viewer", "control-panel"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-hide",
    "core:window:allow-start-dragging"
  ]
}
